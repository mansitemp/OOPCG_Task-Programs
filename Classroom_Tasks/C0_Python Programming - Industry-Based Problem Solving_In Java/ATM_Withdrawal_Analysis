import java.util.Scanner;
 public class ATM_Withdrawal_Analysis{
    public static void main(String[] args) {
        Scanner sc= new Scanner(System.in);

int successful_transactions = 0;
int rejected_transactions = 0;

for (int i=1; i<=10; i++){
    System.out.println("Enter withdrawal amount: ");
    int amount= sc.nextInt();
    if (amount <= 0){
        System.out.println("Transaction Rejected: Invalid amount.");
        rejected_transactions += 1;}

    else if (amount % 500 != 0){
        System.out.println("Transaction Rejected: Amount must be a multiple of 500.");
        rejected_transactions += 1;}

    else if (amount > 20000){
        System.out.println("Transaction Rejected: Maximum withdrawal limit is 20,000.");
        rejected_transactions += 1;}

    else{
        System.out.println("Transaction Successful.");
        successful_transactions += 1;}}

System.out.println("Successful transactions:" +successful_transactions);
System.out.println("Rejected transactions:" +rejected_transactions);
sc.close();
    }}
